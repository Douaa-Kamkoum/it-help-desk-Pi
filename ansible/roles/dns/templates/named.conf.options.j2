options {
    directory "/var/cache/bind";

    listen-on { 127.0.0.1; {{ dns_server_ip }}; };
    listen-on-v6 { none; };

    allow-query { localhost; {{ mgmt_network }}; };

    recursion yes;
    allow-recursion { localhost; {{ mgmt_network }}; };

    forwarders {
{% for f in dns_forwarders %}
        {{ f }};
{% endfor %}
    };

    dnssec-validation auto;
};
