# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Projet d'intégration RSI3 - Infrastructure virtualisée locale
# 4 VMs Ubuntu 24.04 sur VirtualBox
# - Interface 1 : NAT (automatique) : accès Internet et SSH de Vagrant
# - Interface 2 : réseau interne "lan-infra" (LAN de pfSense)
# - Interface 3 : host-only : administration depuis le PC hôte (Ansible)

BOX      = "bento/ubuntu-24.04"
MGMT_NET = "192.168.56"
LAN_NET  = "10.10.10"
LAN_NAME = "lan-infra"
DOMAIN   = "projet.lan"

# Ajustez la RAM selon votre machine hôte
VMS = [
  { name: "vm-dns",     id: 10, ram: 512,  cpus: 1 },
  { name: "vm-web",     id: 11, ram: 1024, cpus: 1 },
  { name: "vm-db",      id: 12, ram: 1024, cpus: 1 },
  { name: "vm-monitor", id: 13, ram: 4096, cpus: 2 }, # Zabbix + Wazuh + Splunk
]

# Lignes de /etc/hosts générées depuis VMS (une seule source de vérité)
HOSTS = VMS.map { |v| "#{LAN_NET}.#{v[:id]} #{v[:name]}.#{DOMAIN} #{v[:name]}" }.join("\n")

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false

  # Désactive le dossier synchronisé par défaut (économie de ressources)
  config.vm.synced_folder ".", "/vagrant", disabled: true

  VMS.each do |vm|
    config.vm.define vm[:name] do |node|
      node.vm.hostname = "#{vm[:name]}.#{DOMAIN}"

      node.vm.network "private_network", ip: "#{LAN_NET}.#{vm[:id]}",
                      virtualbox__intnet: LAN_NAME
      node.vm.network "private_network", ip: "#{MGMT_NET}.#{vm[:id]}"

      node.vm.provider "virtualbox" do |vb|
        vb.name = vm[:name]
        vb.memory = vm[:ram]
        vb.cpus = vm[:cpus]
        vb.linked_clone = true # démarrage plus rapide, moins de disque
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end

      # Configuration initiale minimale (le reste sera fait par Ansible)
      node.vm.provision "shell", env: { "HOSTS" => HOSTS }, inline: <<-SHELL
        set -e
        export DEBIAN_FRONTEND=noninteractive

        # Paquets de base (python3 est requis par Ansible)
        apt-get update -y
        apt-get install -y python3 python3-apt curl wget vim net-tools dnsutils

        # Résolution locale provisoire entre les VMs (avant Bind9)
        sed -i '/# BEGIN projet/,/# END projet/d' /etc/hosts
        { echo "# BEGIN projet"; echo "$HOSTS"; echo "# END projet"; } >> /etc/hosts
      SHELL
    end
  end
end
